# Content-addressed COMMIT_PROOF sample must keep exact bytes on every OS.
# Windows core.autocrlf otherwise rewrites JSON/patch text and breaks verify.
docs/samples/self-incident-commit-proof/** -text
difftest/testdata/** -text
# The secret-scanner corpus: TestSecretCorpusParity compares redaction offsets
# against goldens made from the LF bytes.
benchmarks/secret-scanner-corpus/** -text
internal/collation/root.bin binary
go.mod text eol=lf
go.sum text eol=lf
difftest/testdata/fixtures/** binary
difftest/testdata/fakegit/** text eol=lf
difftest/testdata/recorder/** text eol=lf
difftest/testdata/fakedocker/** text eol=lf
difftest/testdata/fakebrowser/** text eol=lf
# Each slice 4a task appends its posixOnly writer cases to the Windows skip
# list in parallel; a union merge keeps every task's lines.
.github/scripts/windows-writer-skips.txt merge=union
difftest/testdata/fakecodex/** text eol=lf
difftest/testdata/fakegh/** text eol=lf
