#!/bin/sh
# Fake Docker "runtime-build-fail" (README.md): `build` fails (exit 1) with a multi-line stderr holding CR; inspect
# plays runtime-digest, `pull` prints progress lines and exits 0.
# Anything else is refused.
case "$1" in
image)
  if [ "$2" = inspect ]; then
  ref=$5
  case "${ref##*/}" in *:*) repo=${ref%:*} ;; *) repo=$ref ;; esac
  if command -v sha256sum >/dev/null 2>&1; then hex=$(printf '%s' "$ref" | sha256sum); else hex=$(printf '%s' "$ref" | shasum -a 256); fi
  hex=${hex%% *}
  printf '["%s@sha256:%s"]\n' "$repo" "$hex"
  exit 0
  fi
  ;;
pull)
  printf '%s: Pulling from fake/registry\nDigest: fake\nStatus: Image is up to date for %s\n' "$2" "$2"
  exit 0
  ;;
build)
  printf '#5 [2/3] RUN false\r\n#5 ERROR: process "/bin/sh -c false" did not complete successfully: exit code: 1\r\n------\n > [2/3] RUN false:\n------\nERROR: failed to solve: exit code: 1\n' >&2
  exit 1
  ;;
esac
printf 'fake docker (runtime-build-fail): unsupported command: %s\n' "$1" >&2
exit 125
