#!/bin/sh
# Fake Docker "runtime-pull-fail" (README.md): `pull` fails (exit 1, a registry error on stderr); inspect plays
# runtime-digest, `build` prints progress lines and exits 0.
# Anything else is refused.
case "$1" in
image)
  if [ "$2" = inspect ]; then
  ref=$5
  case "${ref##*/}" in *:*) repo=${ref%:*} ;; *) repo=$ref ;; esac
  if command -v sha256sum >/dev/null 2>&1; then hex=$(printf '%s' "$ref" | sha256sum); else hex=$(printf '%s' "$ref" | shasum -a 256); fi
  hex=${hex%% *}
  printf '["%s@sha256:%s"]\n' "$repo" "$hex"
  exit 0
  fi
  ;;
pull)
  printf 'Error response from daemon: pull access denied for %s\n' "$2" >&2
  exit 1
  ;;
build)
  printf '#0 building with "fake" instance\n#1 [internal] load build definition\n#2 DONE 0.0s\n'
  exit 0
  ;;
esac
printf 'fake docker (runtime-pull-fail): unsupported command: %s\n' "$1" >&2
exit 125
