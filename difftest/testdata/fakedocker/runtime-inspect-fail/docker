#!/bin/sh
# Fake Docker "runtime-inspect-fail" (README.md): inspect fails like a missing image (exit 1, `Error: No such image:
# <ref>` on stderr); `pull` and `build` print progress lines and exit 0.
# Anything else is refused.
case "$1" in
image)
  if [ "$2" = inspect ]; then
  printf '\nError: No such image: %s\n' "$5" >&2
  exit 1
  fi
  ;;
pull)
  printf '%s: Pulling from fake/registry\nDigest: fake\nStatus: Image is up to date for %s\n' "$2" "$2"
  exit 0
  ;;
build)
  printf '#0 building with "fake" instance\n#1 [internal] load build definition\n#2 DONE 0.0s\n'
  exit 0
  ;;
esac
printf 'fake docker (runtime-inspect-fail): unsupported command: %s\n' "$1" >&2
exit 125
