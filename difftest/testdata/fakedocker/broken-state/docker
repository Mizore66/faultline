#!/bin/sh
# Fake Docker "broken-state" (difftest/testdata/fakedocker/README.md):
# `pass-fail`, except that state.txt = `broken` fails like a witness that
# does not parse at that state (compile-error's output, exit 1, no result
# line). `rm` succeeds silently.
case "$1" in
rm) exit 0 ;;
run)
  src=
  prev=
  for arg in "$@"; do
    if [ "$prev" = "--mount" ]; then
      case "$arg" in type=bind,src=*) src=${arg#type=bind,src=}; src=${src%%,*} ;; esac
    fi
    prev=$arg
  done
  state=$(cat "$src/state.txt" 2>/dev/null)
  if [ "$state" = broken ]; then
    printf "witness.mjs:3\nSyntaxError: Unexpected token '}'\n" >&2
    exit 1
  fi
  if [ "$state" = bad ]; then
    printf 'state=%s\nFAULTLINE_WITNESS_RESULT={"protocol":"faultline.witness-result.v1","outcome":"PREDICATE_FAIL"}\n' "$state"
    printf 'witness failed' >&2
    exit 1
  fi
  printf 'state=%s\nFAULTLINE_WITNESS_RESULT={"protocol":"faultline.witness-result.v1","outcome":"PREDICATE_PASS"}\n' "$state"
  exit 0
  ;;
esac
printf 'fake docker (broken-state): unsupported command: %s\n' "$1" >&2
exit 125
