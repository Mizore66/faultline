#!/bin/sh
# Fake git for difftest: `git init` fails.
# Everything else runs the real git (PATH without this directory).
here=$(cd "$(dirname "$0")" && pwd)
PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -vxF "$here" | paste -sd: -)
export PATH
# The subcommand: the Git verifier runs `git init ...`; the turn verifier's
# hardened runner puts its global options before it.
. "$here/../lib/subcommand.sh"
# Two diagnostic lines, so a port that drops or rewrites one shows.
if [ "$sub" = init ]; then { printf 'error: planted detail\nfatal: planted failure\n' >&2; exit 128; }; fi
exec git "$@"
