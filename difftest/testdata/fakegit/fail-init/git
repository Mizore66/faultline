#!/bin/sh
# Fake git for difftest: `git init` fails.
# Everything else runs the real git (PATH without this directory).
here=$(cd "$(dirname "$0")" && pwd)
PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -vxF "$here" | paste -sd: -)
export PATH
# Two diagnostic lines, so a port that drops or rewrites one shows.
if [ "$1" = init ]; then { printf 'error: planted detail\nfatal: planted failure\n' >&2; exit 128; }; fi
exec git "$@"
