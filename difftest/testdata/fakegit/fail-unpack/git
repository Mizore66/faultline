#!/bin/sh
# Fake git for difftest: `git unpack-objects` fails, so the turn verifier
# falls back to `index-pack --strict <path>`, which runs the real git.
# Everything else runs the real git (PATH without this directory).
here=$(cd "$(dirname "$0")" && pwd)
PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -vxF "$here" | paste -sd: -)
export PATH
# The hardened runner puts -c pairs, --git-dir=<dir> and -C <dir> before the
# subcommand.
sub=; skip=
for a do
  if [ -n "$skip" ]; then skip=; continue; fi
  case $a in
    -c|-C) skip=1 ;;
    -*) ;;
    *) sub=$a; break ;;
  esac
done
if [ "$sub" = unpack-objects ]; then { echo "fatal: planted unpack failure" >&2; exit 128; }; fi
exec git "$@"
