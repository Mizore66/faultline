#!/bin/sh
# Fake git for difftest: `git rev-parse --show-object-format` fails.
# Everything else runs the real git (PATH without this directory).
here=$(cd "$(dirname "$0")" && pwd)
PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -vxF "$here" | paste -sd: -)
export PATH
# Commands in the temporary repository start with -C <dir>.
if [ "$1" = -C ]; then c1=$3; c2=$4; else c1=$1; c2=$2; fi
if [ "$c1" = rev-parse ] && [ "$c2" = --show-object-format ]; then { echo "fatal: planted failure" >&2; exit 128; }; fi
exec git "$@"
