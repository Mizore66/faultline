{
  "id": "resume-read-draft-throws",
  "outcome": {
    "kind": "error",
    "message": "draft d1 not found"
  },
  "events": [
    {
      "kind": "phase",
      "args": [
        "PREFLIGHT"
      ]
    },
    {
      "kind": "doctor",
      "args": [
        {
          "$t": "object",
          "members": [
            [
              "repository",
              "$ROOT/repo"
            ]
          ]
        }
      ]
    },
    {
      "kind": "phase",
      "args": [
        "INTAKE",
        "resume d1"
      ]
    },
    {
      "kind": "readDraft",
      "args": [
        "$ROOT/repo/.faultline/incidents",
        "d1"
      ]
    }
  ]
}
