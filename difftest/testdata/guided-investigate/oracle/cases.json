    {
      "id": "intake-symptom-selection", "group": "intake", "fixture": "std",
      "files": {
        "match.log": "step one\nERROR: first\nstep two\nAssertion mismatch here\nclean tail\n",
        "nomatch.log": "alpha\n\n  beta  \n",
        "empty.log": "",
        "blank.log": "\n \n\t\n",
        "crlf.log": "ok\r\nfailed: crlf case\r\ntail\r\n",
        "long.log": [{"text": "fail "}, {"repeat": "x", "count": 600}, {"text": "\n"}]
      },
      "steps": [
        {"name": "last matching line", "args": ["investigate", "--ci-log", "{IN}/match.log", "--repo", "{REPO}", "--id", "sym-match", "--port", "0"], "script": [{"do": "ready"}, {"do": "sigint"}], "expect": {"exit": 1, "stdout": "", "stderrContains": ["INTAKE (ci-log)", "cancelled before freeze"]}},
        {"name": "no match uses last line", "args": ["investigate", "--ci-log", "{IN}/nomatch.log", "--repo", "{REPO}", "--id", "sym-none", "--port", "0"], "script": [{"do": "ready"}, {"do": "sigint"}], "expect": {"exit": 1, "stdout": "", "stderrContains": ["cancelled before freeze"]}},
        {"name": "empty log refused by packet schema", "args": ["investigate", "--ci-log", "{IN}/empty.log", "--repo", "{REPO}", "--id", "sym-empty", "--port", "0"], "expect": {"exit": 1, "stdout": "", "stderrContains": ["String must contain at least 1 character(s)"]}},
        {"name": "blank-only log fallback", "args": ["investigate", "--ci-log", "{IN}/blank.log", "--repo", "{REPO}", "--id", "sym-blank", "--port", "0"], "script": [{"do": "ready"}, {"do": "sigint"}], "expect": {"exit": 1, "stdout": "", "stderrContains": ["cancelled before freeze"]}},
        {"name": "crlf lines", "args": ["investigate", "--ci-log", "{IN}/crlf.log", "--repo", "{REPO}", "--id", "sym-crlf", "--port", "0"], "script": [{"do": "ready"}, {"do": "sigint"}], "expect": {"exit": 1, "stdout": "", "stderrContains": ["cancelled before freeze"]}},
        {"name": "symptom limited to 500 units", "args": ["investigate", "--ci-log", "{IN}/long.log", "--repo", "{REPO}", "--id", "sym-long", "--port", "0"], "script": [{"do": "ready"}, {"do": "sigint"}], "expect": {"exit": 1, "stdout": "", "stderrContains": ["cancelled before freeze"]}}
      ]
    },
    {
      "id": "intake-utf16-and-whitespace", "group": "intake", "fixture": "std",
      "files": {
        "boundary.log": [{"repeat": "a", "count": 3999}, {"text": "\ud83d\ude00 tail error\n"}],
        "boundary-before.log": [{"repeat": "a", "count": 3998}, {"text": "\ud83d\ude00 tail\n"}],
        "invalid-utf8.log": [{"text": "bad "}, {"hex": "ff"}, {"text": " byte failure\n"}],
        "js-space.log": [{"text": "\u00a0\u2028error \u3000 spaced\u2029\ufeff\n"}]
      },
      "steps": [
        {"name": "split surrogate at 4000", "args": ["investigate", "--ci-log", "{IN}/boundary.log", "--repo", "{REPO}", "--id", "u16-split", "--port", "0"], "script": [{"do": "ready"}, {"do": "sigint"}], "expect": {"exit": 1, "stdout": "", "stderrContains": ["cancelled before freeze"]}},
        {"name": "whole pair at 3998", "args": ["investigate", "--ci-log", "{IN}/boundary-before.log", "--repo", "{REPO}", "--id", "u16-whole", "--port", "0"], "script": [{"do": "ready"}, {"do": "sigint"}], "expect": {"exit": 1, "stdout": "", "stderrContains": ["cancelled before freeze"]}},
        {"name": "invalid utf-8 byte", "args": ["investigate", "--ci-log", "{IN}/invalid-utf8.log", "--repo", "{REPO}", "--id", "u16-badbyte", "--port", "0"], "script": [{"do": "ready"}, {"do": "sigint"}], "expect": {"exit": 1, "stdout": "", "stderrContains": ["cancelled before freeze"]}},
        {"name": "js whitespace trimming", "args": ["investigate", "--ci-log", "{IN}/js-space.log", "--repo", "{REPO}", "--id", "u16-space", "--command", "\u00a0\ufeff echo \u00e9\u3000 ", "--port", "0"], "script": [{"do": "ready"}, {"do": "sigint"}], "expect": {"exit": 1, "stdout": "", "stderrContains": ["cancelled before freeze"]}}
      ]
    },
    {
      "id": "intake-command-and-range", "group": "intake", "fixture": "std",
      "files": {"ci.log": "FAIL: range\n"},
      "steps": [
        {"name": "explicit range and command", "args": ["investigate", "--ci-log", "{IN}/ci.log", "--repo", "{REPO}", "--id", "range-1", "--from", "{C1}", "--to", "{C2}", "--command", "  node check.mjs  ", "--port", "0"], "script": [{"do": "ready"}, {"do": "sigint"}], "expect": {"exit": 1, "stdout": "", "stderrContains": ["cancelled before freeze"]}},
