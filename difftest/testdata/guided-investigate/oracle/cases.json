        {"name": "resume equals", "args": ["investigate", "--resume=x", "--repo", "{REPO}"], "expect": {"exit": 1, "stdout": "", "stderrContains": ["Usage: fl investigate"]}},
        {"name": "ci-log equals", "args": ["investigate", "--ci-log={IN}/ci.log", "--repo", "{REPO}"], "expect": {"exit": 1, "stdout": "", "stderrContains": ["Usage: fl investigate"]}}
      ]
    },
    {
