        {"name": "blocked empty ci-log", "args": ["investigate", "--ci-log", "", "--repo", "{REPO}"], "expect": {"exit": 1, "stdoutContains": ["\"status\": \"PREFLIGHT_BLOCKED\""]}},
        {"name": "blocked resume", "args": ["investigate", "--resume", "nothing", "--repo", "{REPO}"], "expect": {"exit": 1, "stdoutContains": ["\"status\": \"PREFLIGHT_BLOCKED\""]}}
