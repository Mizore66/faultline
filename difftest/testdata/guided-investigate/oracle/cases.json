        {"name": "empty from and to", "args": ["investigate", "--ci-log", "{IN}/ci.log", "--repo", "{REPO}", "--id", "range-3", "--from", "", "--to", "", "--port", "0"], "script": [{"do": "ready"}, {"do": "sigint"}], "expect": {"exit": 1, "stdout": "", "stderrContains": ["cancelled before freeze"]}},
        {"name": "same id again", "args": ["investigate", "--ci-log", "{IN}/ci.log", "--repo", "{REPO}", "--id", "range-1", "--port", "0"], "expect": {"exit": 1, "stdout": "", "stderrContains": ["FaultLine error:"]}},
        {"name": "unresolvable range accepted at intake", "args": ["investigate", "--ci-log", "{IN}/ci.log", "--repo", "{REPO}", "--id", "range-4", "--from", "not-a-commit", "--to", "{C2}", "--port", "0"], "script": [{"do": "ready"}, {"do": "sigint"}], "expect": {"exit": 1, "stdout": "", "stderrContains": ["cancelled before freeze"]}}
      ]
