#!/bin/sh
# Fake toolchain "head-padded" git (difftest/testdata/faketools/README.md):
# answers `--version` (its last argument, after the -c pairs), and execs the next git on PATH after this directory
# for anything else.
# `show` runs the real git and pads each output line (two spaces before, a space and a CR after) and widens each space to a tab and two spaces.
self=$(cd "$(dirname "$0")" && pwd -P)
for last in "$@"; do :; done
if [ "$#" -gt 0 ] && [ "$last" = --version ]; then
  printf 'git version 2.99.0\n'
  exit 0
fi
# dir is the -C argument, sub the first argument after it.
dir= sub= prev=
for arg in "$@"; do
  if [ "$prev" = -C ]; then dir=$arg
  elif [ -n "$dir" ] && [ -z "$sub" ]; then sub=$arg
  fi
  prev=$arg
done
found= next=
rest=$PATH
while [ -n "$rest" ]; do
  dir=${rest%%:*}
  case "$rest" in *:*) rest=${rest#*:} ;; *) rest= ;; esac
  [ -n "$dir" ] || continue
  if [ -z "$found" ]; then
    [ "$(cd "$dir" 2>/dev/null && pwd -P)" = "$self" ] && found=1
    continue
  fi
  if [ -f "$dir/git" ] && [ -x "$dir/git" ]; then next=$dir/git; break; fi
done
if [ -z "$next" ]; then
  echo "fake toolchain (head-padded): no git after $self on PATH" >&2
  exit 127
fi
if [ "$sub" = show ]; then
  out=$("$next" "$@") || exit $?
  printf '%s\n' "$out" | awk '{ gsub(/ /, "\t  "); printf "  %s \r\n", $0 }'
  exit 0
fi
exec "$next" "$@"
