{
  "name": "@mizore66/faultline",
  "version": "0.1.0",
  "description": "Executable evidence for regressions introduced during Codex-assisted development.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "regression",
    "reproducibility",
    "proof",
    "git",
    "cli",
    "codex",
    "agent"
  ],
  "homepage": "https://github.com/Mizore66/faultline#readme",
  "bugs": {
    "url": "https://github.com/Mizore66/faultline/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mizore66/faultline.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "docs/faultline-self-incident.md",
    "docs/first-incident.md",
    "docs/github-action.md",
    "docs/concepts.md",
    "docs/security-model.md",
    "docs/witness-protocol.md",
    "docs/runtime-preparation.md",
    "docs/proof-bundles.md",
    "docs/codex-sidecar.md",
    "docs/turn-snapshot-overhead.md"
  ],
  "packageManager": "pnpm@10.32.1",
  "bin": {
    "fl": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:package": "node scripts/package-smoke.mjs",
    "benchmark": "node scripts/run-coverage-matrix.mjs",
    "coverage-matrix": "node scripts/run-coverage-matrix.mjs",
    "measure:turn-snapshot": "pnpm build && node --import tsx scripts/measure-turn-snapshot.mjs",
    "dev": "tsx src/server.ts",
    "fl": "tsx src/cli.ts",
    "prepack": "pnpm build",
    "pack:check": "pnpm pack --dry-run"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
