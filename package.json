{
  "name": "faultline",
  "version": "0.1.0",
  "description": "Evidence-first replay and proof for agent-assisted regressions.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "regression",
    "reproducibility",
    "proof",
    "git",
    "cli"
  ],
  "homepage": "https://github.com/Mizore66/faultline#readme",
  "bugs": {
    "url": "https://github.com/Mizore66/faultline/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mizore66/faultline.git"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "fl": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:package": "node scripts/package-smoke.mjs",
    "dev": "tsx src/server.ts",
    "fl": "tsx src/cli.ts"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
